#!name = 淘金币自动签到
#!desc = 淘金币自动签到：自动抓取 Cookie + 每日签到 + 当前金币数通知 + 额外赚金币任务（需抓包回填接口名）
#!author = noodlespring
#!homePage = https://github.com/noodlespring/loon-taojinbi
#!system = ios,macos
#!data = 2026-08-16

[Script]
http-request ^https://h5api\.m\.taobao\.com/h5/ script-path=https://raw.githubusercontent.com/noodlespring/loon-taojinbi/main/taobao_cookie.js, requires-body=true, tag=淘金币抓Cookie, enable=true, timeout=5
cron "30 8 * * *" script-path=https://raw.githubusercontent.com/noodlespring/loon-taojinbi/main/taobao_taojinbi.js, tag=淘金币每日签到, enable=true

[MITM]
hostname = h5api.m.taobao.com
